{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "construct/0.2/geometry.schema.json",
 "title": "Compiled construct geometry (construct-geometry v2, contract construct/0.2)",
 "description": "Structure and budgets of the compiler's output. Y up, front +Z, metres. A consumer re-validates and never trusts the file blindly; see CONTRACT.md for semantics.",
 "$defs": {
  "vec3": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 3,
   "maxItems": 3
  },
  "box": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 3,
   "maxItems": 3
  },
  "quad": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/vec3"
   },
   "minItems": 4,
   "maxItems": 4,
   "description": "top-left, top-right, bottom-right, bottom-left as seen from outside; for a label the first edge is the direction the text runs"
  },
  "phase": {
   "type": "number",
   "minimum": 0,
   "maximum": 1
  }
 },
 "type": "object",
 "additionalProperties": false,
 "required": [
  "format",
  "version",
  "generator",
  "contract",
  "frame",
  "id",
  "title",
  "subject",
  "scene_sha256",
  "provenance",
  "bounds",
  "anchors",
  "stages",
  "parts",
  "styles",
  "style_fields",
  "lines",
  "line_stride",
  "line_fields",
  "fills",
  "fill_stride",
  "fill_fields",
  "points",
  "point_stride",
  "point_fields",
  "motions",
  "articulations",
  "joints",
  "artwork",
  "labels",
  "annotations",
  "presentation",
  "animation",
  "counts"
 ],
 "properties": {
  "format": {
   "const": "construct-geometry"
  },
  "version": {
   "const": 2
  },
  "generator": {
   "type": "string"
  },
  "contract": {
   "const": "construct/0.2"
  },
  "frame": {
   "type": "object",
   "properties": {
    "up": {
     "enum": [
      "+y",
      "+z"
     ]
    },
    "forward": {
     "enum": [
      "+z",
      "-y"
     ]
    },
    "note": {
     "type": "string"
    }
   },
   "required": [
    "forward",
    "note",
    "up"
   ],
   "additionalProperties": false
  },
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
  },
  "title": {
   "type": "string",
   "maxLength": 200
  },
  "subject": {
   "type": "object",
   "properties": {
    "category": {
     "type": "string"
    },
    "summary": {
     "type": "string"
    },
    "accuracy": {
     "enum": [
      "generic",
      "approximate",
      "documented"
     ]
    },
    "synthetic": {
     "type": "boolean"
    }
   },
   "required": [
    "accuracy",
    "category",
    "synthetic"
   ],
   "additionalProperties": false
  },
  "scene_sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "provenance": {
   "type": "object",
   "properties": {
    "sources": {
     "type": "array",
     "maxItems": 64
    },
    "facts": {
     "type": "array",
     "maxItems": 160,
     "items": {
      "type": "object",
      "required": [
       "key",
       "value",
       "certainty"
      ],
      "properties": {
       "value": {
        "type": [
         "string",
         "number",
         "boolean"
        ]
       },
       "certainty": {
        "enum": [
         "verified",
         "user_supplied",
         "inferred",
         "decorative"
        ]
       }
      }
     }
    },
    "assets": {
     "type": "array",
     "maxItems": 32
    },
    "authoring": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "tier",
      "research"
     ],
     "description": "How the construct was authored: the effort tier, whether research was done and from which sources, the identity checklist, the independent critic's record and what would improve it next.",
     "properties": {
      "tier": {
       "enum": [
        "quick",
        "standard",
        "showcase",
        "masterpiece"
       ]
      },
      "research": {
       "enum": [
        "done",
        "not_needed",
        "skipped",
        "unavailable",
        "off"
       ]
      },
      "sources": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "review_rounds": {
       "type": "integer",
       "minimum": 0,
       "maximum": 1000
      },
      "outcome": {
       "enum": [
        "outstanding",
        "good",
        "self-reviewed",
        "limit",
        "unreviewed"
       ]
      },
      "next": {
       "type": "array",
       "maxItems": 8,
       "items": {
        "type": "string",
        "maxLength": 300
       }
      },
      "identity": {
       "type": "array",
       "maxItems": 16,
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "feature",
         "parts"
        ],
        "properties": {
         "feature": {
          "type": "string",
          "maxLength": 200
         },
         "parts": {
          "type": "array",
          "items": {
           "type": "string"
          }
         },
         "source": {
          "type": "string"
         },
         "note": {
          "type": "string"
         }
        }
       }
      },
      "critic": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "scene_sha256",
        "verdict",
        "scores"
       ],
       "properties": {
        "scene_sha256": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$"
        },
        "verdict": {
         "enum": [
          "outstanding",
          "good",
          "improve"
         ]
        },
        "scores": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "silhouette",
          "proportions",
          "identity",
          "depth",
          "composition",
          "assembly",
          "motion",
          "density",
          "honesty"
         ],
         "properties": {
          "silhouette": {
           "type": "integer",
           "minimum": 0,
           "maximum": 3
          },
          "proportions": {
           "type": "integer",
           "minimum": 0,
           "maximum": 3
          },
          "identity": {
           "type": "integer",
           "minimum": 0,
           "maximum": 3
          },
          "depth": {
           "type": "integer",
           "minimum": 0,
           "maximum": 3
          },
          "composition": {
           "type": "integer",
           "minimum": 0,
           "maximum": 3
          },
          "assembly": {
           "type": "integer",
           "minimum": 0,
           "maximum": 3
          },
          "motion": {
           "type": "integer",
           "minimum": 0,
           "maximum": 3
          },
          "density": {
           "type": "integer",
           "minimum": 0,
           "maximum": 3
          },
          "honesty": {
           "type": "integer",
           "minimum": 0,
           "maximum": 3
          }
         }
        },
        "round": {
         "type": "integer",
         "minimum": 0
        },
        "model": {
         "type": "string",
         "maxLength": 120
        },
        "defects": {
         "type": "integer",
         "minimum": 0
        }
       }
      }
     }
    }
   },
   "required": [
    "assets",
    "facts",
    "sources"
   ],
   "additionalProperties": false
  },
  "bounds": {
   "type": "object",
   "properties": {
    "min": {
     "$ref": "#/$defs/vec3"
    },
    "max": {
     "$ref": "#/$defs/vec3"
    },
    "center": {
     "$ref": "#/$defs/vec3"
    },
    "radius": {
     "type": "number",
     "minimum": 0
    },
    "open_min": {
     "$ref": "#/$defs/vec3"
    },
    "open_max": {
     "$ref": "#/$defs/vec3"
    }
   },
   "required": [
    "center",
    "max",
    "min",
    "open_max",
    "open_min",
    "radius"
   ],
   "additionalProperties": false
  },
  "anchors": {
   "type": "object",
   "properties": {
    "base": {
     "type": "object",
     "properties": {
      "point": {
       "$ref": "#/$defs/vec3"
      },
      "up": {
       "$ref": "#/$defs/vec3"
      },
      "from": {
       "enum": [
        "scene",
        "bounds"
       ]
      }
     },
     "required": [
      "from",
      "point",
      "up"
     ],
     "additionalProperties": false
    },
    "front": {
     "type": "object",
     "properties": {
      "corners": {
       "$ref": "#/$defs/quad"
      },
      "part": {
       "type": [
        "string",
        "null"
       ]
      },
      "face": {
       "type": "string"
      },
      "from": {
       "enum": [
        "scene",
        "bounds"
       ]
      }
     },
     "required": [
      "corners",
      "face",
      "from",
      "part"
     ],
     "additionalProperties": false
    },
    "spine": {
     "type": "object",
     "properties": {
      "corners": {
       "$ref": "#/$defs/quad"
      },
      "part": {
       "type": [
        "string",
        "null"
       ]
      },
      "face": {
       "type": "string"
      },
      "from": {
       "enum": [
        "scene",
        "bounds"
       ]
      }
     },
     "required": [
      "corners",
      "face",
      "from",
      "part"
     ],
     "additionalProperties": false
    },
    "grip": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "type": "object",
       "properties": {
        "point": {
         "$ref": "#/$defs/vec3"
        },
        "part": {
         "type": [
          "string",
          "null"
         ]
        },
        "from": {
         "const": "scene"
        }
       },
       "required": [
        "from",
        "part",
        "point"
       ],
       "additionalProperties": false
      }
     ]
    }
   },
   "required": [
    "base",
    "front",
    "grip",
    "spine"
   ],
   "additionalProperties": false
  },
  "stages": {
   "type": "array",
   "maxItems": 8,
   "items": {
    "type": "object",
    "properties": {
     "stage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
     },
     "index": {
      "type": "integer",
      "minimum": 0
     }
    },
    "required": [
     "index",
     "stage"
    ],
    "additionalProperties": false
   }
  },
  "parts": {
   "type": "array",
   "minItems": 1,
   "maxItems": 256,
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "label": {
      "type": "string"
     },
     "role": {
      "enum": [
       "mass",
       "structure",
       "detail",
       "identity",
       "data",
       "ornament",
       "ground",
       "artwork"
      ]
     },
     "certainty": {
      "enum": [
       "verified",
       "user_supplied",
       "inferred",
       "decorative"
      ]
     },
     "basis": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "source": {
      "type": [
       "string",
       "null"
      ]
     },
     "stage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
     },
     "floating": {
      "type": "boolean"
     },
     "shape": {
      "type": "string"
     },
     "motion": {
      "type": [
       "object",
       "null"
      ]
     },
     "joint": {
      "type": "integer",
      "minimum": -1
     },
     "instances": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "min",
        "max",
        "motion_slot",
        "joint"
       ],
       "properties": {
        "min": {
         "$ref": "#/$defs/vec3"
        },
        "max": {
         "$ref": "#/$defs/vec3"
        },
        "motion_slot": {
         "type": "integer",
         "minimum": -1,
         "maximum": 31
        },
        "joint": {
         "type": "integer",
         "minimum": -1,
         "maximum": 15
        },
        "open_min": {
         "$ref": "#/$defs/vec3"
        },
        "open_max": {
         "$ref": "#/$defs/vec3"
        }
       }
      }
     }
    },
    "required": [
     "basis",
     "certainty",
     "floating",
     "id",
     "instances",
     "joint",
     "label",
     "motion",
     "role",
     "shape",
     "source",
     "stage"
    ],
    "additionalProperties": false
   }
  },
  "styles": {
   "type": "array",
   "items": {
    "type": "array",
    "items": {
     "type": "number"
    },
    "minItems": 10,
    "maxItems": 10
   }
  },
  "style_fields": {
   "const": [
    "tone",
    "alpha",
    "width_px",
    "glow_px",
    "dash",
    "fade",
    "part",
    "motion_slot",
    "occluder",
    "joint"
   ]
  },
  "lines": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "maxItems": 216000
  },
  "line_stride": {
   "const": 9
  },
  "line_fields": {
   "const": [
    "ax",
    "ay",
    "az",
    "bx",
    "by",
    "bz",
    "style",
    "phase_a",
    "phase_b"
   ]
  },
  "fills": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "maxItems": 360000
  },
  "fill_stride": {
   "const": 5
  },
  "fill_fields": {
   "const": [
    "x",
    "y",
    "z",
    "style",
    "phase"
   ]
  },
  "points": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "maxItems": 42000
  },
  "point_stride": {
   "const": 7
  },
  "point_fields": {
   "const": [
    "x",
    "y",
    "z",
    "size_px",
    "style",
    "sprite",
    "phase"
   ]
  },
  "motions": {
   "type": "array",
   "maxItems": 32,
   "items": {
    "type": "object",
    "properties": {
     "type": {
      "enum": [
       "spin",
       "swing",
       "bob",
       "pulse"
      ]
     },
     "axis": {
      "$ref": "#/$defs/vec3"
     },
     "pivot": {
      "$ref": "#/$defs/vec3"
     },
     "rpm": {
      "type": "number"
     },
     "degrees": {
      "type": "number"
     },
     "distance": {
      "type": "number"
     },
     "period": {
      "type": "number"
     },
     "amount": {
      "type": "number"
     },
     "phase": {
      "$ref": "#/$defs/phase"
     },
     "part": {
      "type": "string"
     }
    },
    "required": [
     "amount",
     "axis",
     "degrees",
     "distance",
     "part",
     "period",
     "phase",
     "pivot",
     "rpm",
     "type"
    ],
    "additionalProperties": false
   }
  },
  "articulations": {
   "type": "array",
   "maxItems": 16,
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "type": {
      "enum": [
       "hinge",
       "slide",
       "lift",
       "turn"
      ]
     },
     "axis": {
      "$ref": "#/$defs/vec3"
     },
     "pivot": {
      "oneOf": [
       {
        "type": "null"
       },
       {
        "$ref": "#/$defs/vec3"
       }
      ]
     },
     "amount": {
      "type": "number"
     },
     "unit": {
      "enum": [
       "deg",
       "m"
      ]
     },
     "order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
     },
     "parts": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "instances": {
      "type": "array",
      "items": {
       "type": "array",
       "prefixItems": [
        {
         "type": "string"
        },
        {
         "type": "integer",
         "minimum": 0
        }
       ],
       "minItems": 2,
       "maxItems": 2
      }
     }
    },
    "required": [
     "amount",
     "axis",
     "id",
     "instances",
     "order",
     "parts",
     "pivot",
     "type",
     "unit"
    ],
    "additionalProperties": false
   }
  },
  "joints": {
   "type": "array",
   "maxItems": 16,
   "items": {
    "type": "array",
    "minItems": 1,
    "maxItems": 16,
    "items": {
     "type": "integer",
     "minimum": 0,
     "maximum": 15
    }
   }
  },
  "artwork": {
   "type": "array",
   "maxItems": 256,
   "items": {
    "type": "object",
    "properties": {
     "part": {
      "type": "string"
     },
     "slot": {
      "type": "string",
      "pattern": "^(cover-front|cover-back|inlay|disc|label|booklet-page-([1-9]|[1-5][0-9]|6[0-4]))$"
     },
     "asset_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "face": {
      "type": "string"
     },
     "corners": {
      "$ref": "#/$defs/quad"
     },
     "uv": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
       "type": "array",
       "items": {
        "type": "number"
       },
       "minItems": 2,
       "maxItems": 2
      }
     },
     "mask": {
      "enum": [
       "rect",
       "circle"
      ]
     },
     "inner_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     },
     "certainty": {
      "enum": [
       "verified",
       "user_supplied",
       "inferred",
       "decorative"
      ]
     },
     "motion_slot": {
      "type": "integer",
      "minimum": -1
     },
     "joint": {
      "type": "integer",
      "minimum": -1
     },
     "phase": {
      "$ref": "#/$defs/phase"
     }
    },
    "required": [
     "asset_id",
     "certainty",
     "corners",
     "face",
     "inner_ratio",
     "joint",
     "mask",
     "motion_slot",
     "part",
     "phase",
     "slot",
     "uv"
    ],
    "additionalProperties": false
   }
  },
  "labels": {
   "type": "array",
   "maxItems": 48,
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "part": {
      "type": "string"
     },
     "face": {
      "type": "string"
     },
     "corners": {
      "$ref": "#/$defs/quad"
     },
     "field": {
      "type": [
       "string",
       "null"
      ]
     },
     "text": {
      "type": "string",
      "maxLength": 2000
     },
     "certainty": {
      "enum": [
       "verified",
       "user_supplied",
       "inferred",
       "decorative"
      ]
     },
     "role": {
      "enum": [
       "title",
       "creator",
       "meta",
       "catalog",
       "body",
       "decorative"
      ]
     },
     "align": {
      "enum": [
       "left",
       "center",
       "right"
      ]
     },
     "orientation": {
      "enum": [
       "horizontal",
       "vertical-down",
       "vertical-up"
      ]
     },
     "motion_slot": {
      "type": "integer",
      "minimum": -1
     },
     "joint": {
      "type": "integer",
      "minimum": -1
     },
     "phase": {
      "$ref": "#/$defs/phase"
     }
    },
    "required": [
     "align",
     "certainty",
     "corners",
     "face",
     "field",
     "id",
     "joint",
     "motion_slot",
     "orientation",
     "part",
     "phase",
     "role",
     "text"
    ],
    "additionalProperties": false
   }
  },
  "annotations": {
   "type": "array",
   "maxItems": 32,
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "text": {
      "type": "string",
      "maxLength": 80
     },
     "part": {
      "type": "string"
     },
     "anchor": {
      "$ref": "#/$defs/vec3"
     },
     "joint": {
      "type": "integer",
      "minimum": -1
     },
     "certainty": {
      "enum": [
       "verified",
       "user_supplied",
       "inferred",
       "decorative"
      ]
     }
    },
    "required": [
     "anchor",
     "certainty",
     "id",
     "joint",
     "part",
     "text"
    ],
    "additionalProperties": false
   }
  },
  "presentation": {
   "type": "object",
   "required": [
    "framing",
    "views",
    "atmosphere",
    "occlusion",
    "certainty_style",
    "background",
    "float",
    "style_hint",
    "still_pose"
   ],
   "properties": {
    "style_hint": {
     "type": "object",
     "properties": {
      "palette": {
       "type": "string"
      },
      "identity": {
       "type": "string"
      },
      "note": {
       "type": "string"
      }
     },
     "required": [
      "identity",
      "note",
      "palette"
     ],
     "additionalProperties": false
    },
    "still_pose": {
     "enum": [
      "open",
      "closed"
     ]
    }
