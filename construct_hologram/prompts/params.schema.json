{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "construct/0.2/params.schema.json",
 "title": "Construct parameter document (construct-params v1)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "format",
  "version",
  "archetype",
  "variant",
  "id",
  "title",
  "facts"
 ],
 "properties": {
  "format": {
   "const": "construct-params"
  },
  "version": {
   "const": 1
  },
  "archetype": {
   "enum": [
    "book",
    "case",
    "object",
    "vehicle",
    "vessel"
   ]
  },
  "variant": {
   "enum": [
    "acoustic-guitar",
    "bass-guitar",
    "bottle",
    "box",
    "can",
    "coupe",
    "digipak",
    "electric-guitar",
    "glass",
    "hardcover",
    "jewel",
    "paperback",
    "sedan",
    "slim",
    "synth",
    "wedge"
   ]
  },
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
  },
  "title": {
   "type": "string",
   "minLength": 1,
   "maxLength": 200
  },
  "summary": {
   "type": "string",
   "maxLength": 600
  },
  "synthetic": {
   "type": "boolean"
  },
  "sources": {
   "type": "array",
   "maxItems": 64,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "kind",
     "title",
     "rights"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "user_request",
       "user_supplied",
       "document",
       "measurement",
       "observation",
       "dataset",
       "generated",
       "drawing",
       "reference_image"
      ]
     },
     "title": {
      "type": "string"
     },
     "rights": {
      "enum": [
       "synthetic",
       "user_private",
       "permitted",
       "public_domain",
       "reference_only"
      ]
     },
     "ref": {
      "type": "string"
     }
    }
   }
  },
  "facts": {
   "type": "array",
   "maxItems": 160,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "key",
     "value",
     "certainty"
    ],
    "properties": {
     "key": {
      "type": "string",
      "maxLength": 120
     },
     "value": {
      "type": [
       "string",
       "number",
       "boolean"
      ]
     },
     "unit": {
      "type": "string",
      "maxLength": 24
     },
     "certainty": {
      "enum": [
       "verified",
       "user_supplied",
       "inferred",
       "decorative"
      ]
     },
     "source": {
      "type": "string"
     },
     "note": {
      "type": "string",
      "maxLength": 600
     }
    }
   }
  },
  "assets": {
   "type": "array",
   "maxItems": 32,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "path",
     "sha256",
     "media_type",
     "rights",
     "provenance"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "path": {
      "type": "string"
     },
     "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     },
     "media_type": {
      "enum": [
       "image/png",
       "image/jpeg",
       "image/webp"
      ]
     },
     "rights": {
      "enum": [
       "synthetic",
       "user_private",
       "permitted"
      ]
     },
     "provenance": {
      "enum": [
       "authentic",
       "synthetic",
       "generated-decorative",
       "user_photo"
      ]
     },
     "source": {
      "type": "string"
     }
    }
   }
  },
  "artwork": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "cover-back": {
     "type": "string"
    },
    "cover-front": {
     "type": "string"
    },
    "disc": {
     "type": "string"
    },
    "inlay": {
     "type": "string"
    },
    "label": {
     "type": "string"
    }
   }
  },
  "params": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "width": {
     "type": "number",
     "minimum": 0.02,
     "maximum": 3.0,
     "description": "outer width, metres"
    },
    "height": {
     "type": "number",
     "minimum": 0.02,
     "maximum": 3.0,
     "description": "outer height, metres"
    },
    "depth": {
     "type": "number",
     "minimum": 0.002,
     "maximum": 1.0,
     "description": "outer depth (thickness) closed, metres"
    },
    "thickness": {
     "type": "number",
     "minimum": 0.003,
     "maximum": 0.2,
     "description": "thickness of the closed book, metres"
    },
    "diameter": {
     "type": "number",
     "minimum": 0.02,
     "maximum": 0.5,
     "description": "widest diameter, metres"
    },
    "discs": {
     "type": "integer",
     "minimum": 1,
     "maximum": 12,
     "description": "number of discs"
    },
    "scale_length": {
     "type": "number",
     "minimum": 0.4,
     "maximum": 1.0,
     "description": "nut-to-bridge string length, metres"
    },
    "strings": {
     "type": "integer",
     "minimum": 4,
     "maximum": 12,
     "description": "number of strings"
    },
    "frets": {
     "type": "integer",
     "minimum": 12,
     "maximum": 27,
     "description": "number of frets"
    },
    "pickups": {
     "type": "integer",
     "minimum": 0,
     "maximum": 3,
     "description": "number of pickups"
    },
    "knobs": {
     "type": "integer",
     "minimum": 0,
     "maximum": 6,
     "description": "number of control knobs"
    },
    "keys": {
     "type": "integer",
     "minimum": 25,
     "maximum": 88,
     "description": "number of keys"
    },
    "knob_rows": {
     "type": "integer",
     "minimum": 0,
     "maximum": 4,
     "description": "rows of knobs on the panel"
    },
    "knobs_per_row": {
     "type": "integer",
     "minimum": 0,
     "maximum": 16,
     "description": "knobs in each row"
    },
    "fill": {
     "type": "number",
     "minimum": 0.0,
     "maximum": 1.0,
     "description": "how full the glass is"
    },
    "length": {
     "type": "number",
     "minimum": 1.0,
     "maximum": 12.0,
     "description": "overall length, metres"
    },
    "wheelbase": {
     "type": "number",
     "minimum": 0.8,
     "maximum": 7.0,
     "description": "front to rear axle, metres"
    },
    "wheel_diameter": {
     "type": "number",
     "minimum": 0.3,
     "maximum": 1.5,
     "description": "outer tyre diameter, metres"
    },
    "body_style": {
     "enum": [
      "double-cut",
      "single-cut",
      "offset"
     ]
    },
    "glass_style": {
     "enum": [
      "pint",
      "tulip",
      "stange"
     ]
    },
    "screen": {
     "type": "boolean"
    },
    "wheels": {
     "type": "boolean"
    }
   }
  },
  "param_certainty": {
   "type": "object",
   "additionalProperties": {
    "enum": [
     "verified",
     "user_supplied",
     "inferred"
    ]
   }
  },
  "authoring": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "tier",
    "research"
   ],
   "description": "How the construct was authored: the effort tier, whether research was done and from which sources, the identity checklist, the independent critic's record and what would improve it next.",
   "properties": {
    "tier": {
     "enum": [
      "quick",
      "standard",
      "showcase",
      "masterpiece"
     ]
    },
    "research": {
     "enum": [
      "done",
      "not_needed",
      "skipped",
      "unavailable",
      "off"
     ]
    },
    "sources": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "review_rounds": {
     "type": "integer",
     "minimum": 0,
     "maximum": 1000
    },
    "outcome": {
     "enum": [
      "outstanding",
      "good",
      "self-reviewed",
      "limit",
      "unreviewed"
     ]
    },
    "next": {
     "type": "array",
     "maxItems": 8,
     "items": {
      "type": "string",
      "maxLength": 300
     }
    },
    "identity": {
     "type": "array",
     "maxItems": 16,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "feature",
       "parts"
      ],
      "properties": {
       "feature": {
        "type": "string",
        "maxLength": 200
       },
       "parts": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "source": {
        "type": "string"
       },
       "note": {
        "type": "string"
       }
      }
     }
    },
    "rounds": {
     "type": "array",
     "maxItems": 40,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "round",
       "result"
      ],
      "properties": {
       "round": {
        "type": "integer",
        "minimum": 0
       },
       "result": {
        "enum": [
         "baseline",
         "kept",
         "reverted"
        ]
       },
       "minutes": {
        "type": "number",
        "minimum": 0
       },
       "changes": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "summary": {
        "type": "string",
        "maxLength": 200
       }
      }
     }
    },
    "compare": {
     "type": "array",
     "maxItems": 8,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "view",
       "reference",
       "iou",
       "edge",
       "pass",
       "scene_sha256"
      ],
      "properties": {
       "view": {
        "type": "string"
       },
       "reference": {
        "type": "string"
       },
       "iou": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
       },
       "edge": {
        "type": "number",
        "minimum": 0
       },
       "pass": {
        "type": "boolean"
       },
       "scene_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       }
      }
     }
    },
    "critic": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "scene_sha256",
      "verdict",
      "scores"
     ],
     "properties": {
      "scene_sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "verdict": {
       "enum": [
        "outstanding",
        "good",
        "improve"
       ]
      },
      "scores": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "silhouette",
        "proportions",
        "identity",
        "depth",
        "composition",
        "assembly",
        "motion",
        "density",
        "honesty"
       ],
       "properties": {
        "silhouette": {
         "type": "integer",
         "minimum": 0,
         "maximum": 3
        },
        "proportions": {
         "type": "integer",
         "minimum": 0,
         "maximum": 3
        },
        "identity": {
         "type": "integer",
         "minimum": 0,
         "maximum": 3
        },
        "depth": {
         "type": "integer",
         "minimum": 0,
         "maximum": 3
        },
        "composition": {
         "type": "integer",
         "minimum": 0,
         "maximum": 3
        },
        "assembly": {
         "type": "integer",
         "minimum": 0,
         "maximum": 3
        },
        "motion": {
         "type": "integer",
         "minimum": 0,
         "maximum": 3
        },
        "density": {
         "type": "integer",
         "minimum": 0,
         "maximum": 3
        },
        "honesty": {
         "type": "integer",
         "minimum": 0,
         "maximum": 3
        }
       }
      },
      "round": {
       "type": "integer",
       "minimum": 0
      },
      "model": {
       "type": "string",
       "maxLength": 120
      },
      "defects": {
       "type": "integer",
       "minimum": 0
      }
     }
    }
   }
  }
 },
 "x-variants": {
  "case": [
   "box",
   "digipak",
   "jewel",
   "slim"
  ],
  "book": [
   "hardcover",
   "paperback"
  ],
  "object": [
   "acoustic-guitar",
   "bass-guitar",
   "electric-guitar",
   "synth"
  ],
  "vehicle": [
   "coupe",
   "sedan",
   "wedge"
  ],
  "vessel": [
   "bottle",
   "can",
   "glass"
  ]
 }
}
